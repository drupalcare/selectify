{
  "extends": "stylelint-config-standard",
  "plugins": ["stylelint-order"],
  "rules": {
    "order/properties-order": [
      "position",
      "top",
      "right",
      "bottom",
      "left",
      "z-index",
      "display",
      "visibility",
      "overflow",
      "overflow-x",
      "overflow-y",
      "width",
      "min-width",
      "max-width",
      "height",
      "min-height",
      "max-height",
      "margin",
      "margin-top",
      "margin-right",
      "margin-bottom",
      "margin-left",
      "padding",
      "padding-top",
      "padding-right",
      "padding-bottom",
      "padding-left",
      "border",
      "border-width",
      "border-style",
      "border-radius",
      "border-color",
      "border-top-left-radius",
      "border-top-right-radius",
      "border-bottom-right-radius",
      "border-bottom-left-radius",
      "outline",
      "outline-offset",
      "box-shadow",
      "box-sizing",
      "background",
      "background-color",
      "background-image",
      "background-repeat",
      "background-position",
      "background-size",
      "color",
      "font-size",
      "font-weight",
      "font-style",
      "font-variation-settings",
      "line-height",
      "text-align",
      "text-decoration",
      "text-indent",
      "white-space",
      "vertical-align",
      "cursor",
      "opacity",
      "transform",
      "transition",
      "flex",
      "flex-direction",
      "flex-grow",
      "flex-wrap",
      "align-items",
      "justify-content",
      "gap",
      "pointer-events",
      "clip",
      "clip-path",
      "content",
      "appearance",
      "-webkit-appearance",
      "mask-image",
      "-webkit-mask-image",
      "all"
    ],
    "color-hex-length": "short",
    "color-function-notation": "modern",
    "length-zero-no-unit": true,
    "declaration-block-no-shorthand-property-overrides": true,
    "declaration-block-no-duplicate-properties": true,
    "selector-pseudo-element-no-unknown": [
      true,
      { "ignorePseudoElements": ["::before", "::after"] }
    ],
    "no-duplicate-selectors": null,
    "no-descending-specificity": null,
    "number-max-precision": 4,
    "selector-class-pattern": null,
    "selector-id-pattern": null,
    "custom-property-pattern": null
  }
}
