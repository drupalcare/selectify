# ===================
# Drupal contrib module .gitignore
# ===================

# ----- Node / npm (dev tooling only) -----
node_modules/
package-lock.json

# ----- IDE and editor files -----
.idea/
.vscode/
*.swp
*.swo
*~
nbproject/
.project
.settings/
.buildpath

# ----- OS files -----
.DS_Store
Thumbs.db
Desktop.ini
._*

# ----- Internal / planning docs (not part of the module) -----
PLAN-*.md
LOCAL-CI.md
homepage-drupal.html

# ----- AI / Claude -----
.claude/
CLAUDE.md
.claude-*

# ----- Composer (local dev) -----
/vendor/
composer.lock
composer.phar

# ----- Environment / secrets -----
.env
.env.*

# ----- Test / CI artifacts -----
.phpunit.result.cache
.phpunit.cache/
coverage/
.phpcs-cache

# ----- Build artifacts -----
*.map
scripts/run-ci-checks.sh
ANALYSIS-dual-vs-dropdown-search.md
docs/CSS-RTL-LTR-MODERNIZATION-PLAN.md
docs/JS-CODE-QUALITY-ASSESSMENT.md
