{
    "name": "drupal/selectify",
    "description": "Enhanced select dropdowns with multiple widget styles for Drupal forms, Views filters, radio buttons, and checkboxes. Provides modern UI widgets including searchable dropdowns, tags, dual-list selection, and custom styling options.",
    "type": "drupal-module",
    "license": "GPL-2.0-or-later",
    "homepage": "https://www.drupal.org/project/selectify",
    "authors": [
        {
            "name": "Alaa Haddad",
            "homepage": "https://www.drupal.org/u/flashwebcenter",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://www.drupal.org/project/issues/selectify",
        "source": "https://git.drupalcode.org/project/selectify",
        "docs": "https://www.drupal.org/project/selectify"
    },
    "require": {
        "php": ">=8.1",
        "drupal/core": "^10 || ^11 || ^12"
    },
    "require-dev": {
        "drupal/core-dev": "^10 || ^11 || ^12",
        "drupal/webform": "^6.3"
    }
}
