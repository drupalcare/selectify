use Drupal\Component\Utility\Html;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\Element;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\Template\Attribute;

/**
 * Implements hook_preprocess_html().
 */
function selectify_preprocess_html(&$variables) {
  /** @var \Drupal\selectify\Service\SelectifyHelper $helper */
  $helper = \Drupal::service('selectify.helper');

  // Check if current page is in the disabled pages list.
  if ($helper->isPageDisabled()) {
    return;
  }

  $config = \Drupal::config('selectify.settings');
  $radioEnabled = $config->get('enable_radio');
  $checkboxEnabled = $config->get('enable_checkbox');

  if (!$radioEnabled && !$checkboxEnabled) {
    return;
  }

  /** @var \Drupal\selectify\Service\SelectifyStyleService $styleService */
  $styleService = \Drupal::service('selectify.style_service');
  $bodyClasses = $styleService->getBodyClasses();

  if (!empty($bodyClasses)) {
    $classes = explode(' ', $bodyClasses);
    foreach ($classes as $class) {
      $variables['attributes']['class'][] = $class;
    }
  }

  // Add selectify-color-disabled class when the active color mode is none.
  $colorMode = $helper->isAdminRoute()
    ? ($config->get('admin_accent_color_mode') ?? 'light')
    : ($config->get('accent_color_mode') ?? 'light');

  if ($colorMode === 'none') {
    $variables['attributes']['class'][] = 'selectify-color-disabled';
  }
}

/**
 * Implements hook_help().
 */
function selectify_help($route_name, RouteMatchInterface $route_match): ?string {
  if ($route_name === 'help.page.selectify') {
    return _selectify_render_readme();
  }
  return NULL;
}

/**
 * Helper function to render README.md.
 *
 * @return string
 *   The rendered content of README.md.
 */
function _selectify_render_readme(): string {
  $readme_path = __DIR__ . '/README.md';
  $text = file_get_contents($readme_path);

  if ($text === FALSE) {
    return t('README.md file not found.');
  }

  if (!\Drupal::moduleHandler()->moduleExists('markdown')) {
    return '<pre>' . htmlspecialchars($text) . '</pre>';
  }

  $filter_manager = \Drupal::service('plugin.manager.filter');
  $settings = \Drupal::config('markdown.settings')->getRawData();
  $filter = $filter_manager->createInstance('markdown', ['settings' => $settings]);
  return $filter->process($text, 'en')->getProcessedText();
}

/**
 * Implements hook_theme_suggestions_select_alter().
 */
function selectify_theme_suggestions_select_alter(array &$suggestions, array $variables) {
  if (empty($variables['element']['#attributes']['class'])) {
    return;
  }

  $classes = (array) $variables['element']['#attributes']['class'];

  foreach ($suggestions as $key => $suggestion) {
    if (strpos($suggestion, 'form_element') !== FALSE) {
      unset($suggestions[$key]);
    }
  }

  $class_to_suggestion = [
    'selectify-apply-dropdown' => 'select__selectify_dropdown',
    'selectify-apply-checkbox' => 'select__selectify_dropdown_checkbox',
    'selectify-apply-searchable' => 'select__selectify_dropdown_searchable',
    'selectify-apply-tags' => 'select__selectify_dropdown_tags',
    'selectify-apply-dual' => 'select__selectify_dual',
  ];

  foreach ($class_to_suggestion as $class => $suggestion) {
    if (in_array($class, $classes)) {
      $suggestions[] = $suggestion;
    }
  }
}

/**
 * Implements hook_theme().
 */
function selectify_theme($existing, $type, $theme, $path) {
  return [
    'select__selectify_dropdown' => [
      'base hook' => 'select',
      'template' => 'select--selectify-dropdown',
      'path' => $path . '/templates',
    ],
    'select__selectify_dropdown_checkbox' => [
      'base hook' => 'select',
      'template' => 'select--selectify-dropdown-checkbox',
      'path' => $path . '/templates',
    ],
    'select__selectify_dropdown_searchable' => [
      'base hook' => 'select',
      'template' => 'select--selectify-dropdown-searchable',
      'path' => $path . '/templates',
    ],
    'select__selectify_dropdown_tags' => [
      'base hook' => 'select',
      'template' => 'select--selectify-dropdown-tags',
      'path' => $path . '/templates',
    ],
    'select__selectify_dual' => [
      'base hook' => 'select',
      'template' => 'select--selectify-dual',
      'path' => $path . '/templates',
    ],
  ];
}

/**
 * Preprocess function for Selectify form widgets.
 */
function selectify_preprocess_select__selectify_dropdown(&$variables) {
  _selectify_preprocess_widget($variables);
}

/**
 * Preprocess function for Selectify form widgets.
 */
function selectify_preprocess_select__selectify_dropdown_checkbox(&$variables) {
  _selectify_preprocess_widget($variables);
}

/**
 * Preprocess function for Selectify form widgets.
 */
function selectify_preprocess_select__selectify_dropdown_searchable(&$variables) {
  _selectify_preprocess_widget($variables);
}

/**
 * Preprocess function for Selectify form widgets.
 */
function selectify_preprocess_select__selectify_dropdown_tags(&$variables) {
  _selectify_preprocess_widget($variables);
}

/**
 * Preprocess function for Selectify form widgets.
 */
function selectify_preprocess_select__selectify_dual(&$variables) {
  _selectify_preprocess_widget($variables);
}

/**
 * Flattens select #options to a list of all option keys (handles optgroups).
 *
 * Works for flat options (Views, Webform, Field UI) and nested optgroup
 * structure so the same logic applies across all form types.
 *
 * @param array $options
 *   The #options array (value => label or group => [value => label, ...]).
 *
 * @return array
 *   List of option value keys.
 */
function _selectify_flatten_option_keys(array $options): array {
  $keys = [];
  foreach ($options as $key => $value) {
    if (is_array($value)) {
      $keys = array_merge($keys, _selectify_flatten_option_keys($value));
    }
    else {
      $keys[] = $key;
    }
  }
  return $keys;
}

/**
 * Common preprocessing logic for all Selectify widgets.
 */
function _selectify_preprocess_widget(array &$variables) {
  if (!isset($variables['element'])) {
    return;
  }

  /** @var \Drupal\selectify\Service\SelectifyHelper $helper */
  $helper = \Drupal::service('selectify.helper');

  $element = $variables['element'];
  $raw_attributes = $element['#attributes'] ?? [];
  $variables['attributes'] = new Attribute($raw_attributes);

  // Determine if a visible label exists.
  $has_label = !empty($element['#title']) && ($element['#label_display'] ?? 'visible') !== 'hidden';
  $variables['has_label'] = $has_label;

  if ($has_label && isset($raw_attributes['id'])) {
    $label_id = $raw_attributes['id'] . '-label';
    $variables['label_id'] = $label_id;
  }

  $variables['has_description'] = !empty($element['#description']);

  // Generate fallback aria-label if no label will be printed.
  if (!$has_label && isset($raw_attributes['id'])) {
    $id = (string) $raw_attributes['id'];
    $clean_label = preg_replace('/^edit-/', '', $id);
    $clean_label = ucwords(str_replace('-', ' ', $clean_label));
    $variables['aria_label'] = t('Select @label', ['@label' => $clean_label]);
  }

  // Detect if it's part of a Views exposed form.
  $is_views = !empty($raw_attributes['class']) && in_array('selectify-views', (array) $raw_attributes['class']);
  $variables['is_views'] = $is_views;

  if ($is_views) {
    $variables['unique_id'] = $raw_attributes['id'] ?? '';
    $variables['is_multiple'] = ($raw_attributes['multiple'] ?? '') === 'multiple';
    $variables['max_selected'] = $variables['is_multiple'] ? NULL : 1;
    $variables['field_name'] = $raw_attributes['name'] ?? '';
    $variables['views_attributes'] = [
      'data-drupal-selector' => $raw_attributes['data-drupal-selector'] ?? '',
      'class' => implode(' ', (array) ($raw_attributes['class'] ?? [])),
      'size' => $raw_attributes['size'] ?? '',
      'aria-invalid' => $raw_attributes['aria-invalid'] ?? '',
    ];
  }
  else {
    $variables['field_name'] = $raw_attributes['data-field-name'] ?? 'unknown';
    $variables['max_selected'] = $raw_attributes['data-max-selections'] ?? NULL;
    $variables['is_multiple'] = filter_var($raw_attributes['data-multiple'] ?? FALSE, FILTER_VALIDATE_BOOLEAN);
    $variables['placeholder'] = $raw_attributes['data-placeholder'] ?? '';
    $variables['is_required'] = filter_var($raw_attributes['aria-required'] ?? FALSE, FILTER_VALIDATE_BOOLEAN);
    $variables['views_attributes'] = [];

    // Ensure non-Views widgets always have a stable, unique ID so that the
    // JavaScript behavior can locate the hidden native <select>. This is
    // especially important for Webform elements, which may not provide an ID
    // on the original select element.
    $variables['unique_id'] = $raw_attributes['id'] ?? 'selectify-default-id';
    if ($variables['unique_id'] === 'selectify-default-id') {
      $base = $variables['field_name'] ?: 'selectify-field';
      $variables['unique_id'] = Html::getUniqueId('edit-' . $base);
    }
  }

  // Generate clean field name for use in IDs.
  $clean_field_name = str_replace(['_', '[]'], ['-', ''], $variables['field_name']);
  $variables['clean_field_name'] = $clean_field_name;

  // Get the active theme and root parent theme via helper service.
  $theme_name = $helper->getActiveThemeName();
  $parent_theme = $helper->getRootParentTheme($theme_name);

  $theme_classes = [];
  if (!empty($parent_theme) && $parent_theme !== $theme_name) {
    $theme_classes[] = 'theme-parent-' . $helper->cleanThemeName($parent_theme);
  }
  $theme_classes[] = 'theme-' . $helper->cleanThemeName($theme_name);

  $config = $helper->getRadioCheckboxConfig();
  $variables['enable_checkbox'] = !empty($config['enable_checkbox']);
  $variables['attributes']->addClass($theme_classes);

  // Guarantee that the rendered <select> (and its hidden counterpart) carry
  // the unique ID used by the JavaScript behavior as data-target-id. This
  // fixes cases where upstream elements (such as Webform composites) omit an
  // explicit ID, which previously caused the dropdown not to open because the
  // native <select> could not be located.
  if ($variables['unique_id']) {
    $variables['attributes']->setAttribute('id', $variables['unique_id']);
  }

  // Hide Clear when 1–3 options (e.g. Sort by, Order); show when 4+ for better UI.
  // Works for all form types: Views, Webform, Field UI, entity forms. Flatten
  // so optgroup-based #options are counted correctly if ever used.
  $options = $element['#options'] ?? [];
  $selectable_keys = _selectify_flatten_option_keys($options);
  $selectable_keys = array_filter($selectable_keys, function ($key) {
    return $key !== '_none' && $key !== 'All' && $key !== '';
  });
  $variables['selectify_few_options'] = count($selectable_keys) <= 3;
}

/**
 * Implements hook_preprocess_form_element() for Selectify.
 */
function selectify_preprocess_form_element(array &$variables): void {
  /** @var \Drupal\selectify\Service\SelectifyHelper $helper */
  $helper = \Drupal::service('selectify.helper');
  $config = $helper->getRadioCheckboxConfig();

  if ($config === FALSE) {
    return;
  }

  if (!isset($variables['element']['#type'])) {
    return;
  }

  $type = $variables['element']['#type'];

  if ($type === 'radio' && ($config['enable_radio'] === TRUE)) {
    $variables['attributes']['class'][] = 'selectify-form-item selectify-radio-wrapper';
  }
  elseif ($type === 'checkbox' && ($config['enable_checkbox'] === TRUE)) {
    $variables['attributes']['class'][] = 'selectify-form-item selectify-checkbox-wrapper';
  }
}

/**
 * Implements hook_preprocess_input() for Selectify.
 */
function selectify_preprocess_input(array &$variables): void {
  /** @var \Drupal\selectify\Service\SelectifyHelper $helper */
  $helper = \Drupal::service('selectify.helper');
  $config = $helper->getRadioCheckboxConfig();

  if ($config === FALSE) {
    return;
  }

  if (!isset($variables['attributes']['type'])) {
    return;
  }

  $type = $variables['attributes']['type'];

  if ($type === 'radio' && ($config['enable_radio'] === TRUE)) {
    $variables['attributes']['class'][] = 'selectify-radio';
  }
  elseif ($type === 'checkbox' && ($config['enable_checkbox'] === TRUE)) {
    $variables['attributes']['class'][] = 'selectify-checkbox';
  }
}

/**
 * Implements hook_page_attachments() for Selectify.
 */
function selectify_page_attachments(array &$attachments) {
  /** @var \Drupal\selectify\Service\SelectifyHelper $helper */
  $helper = \Drupal::service('selectify.helper');
  $config = $helper->getRadioCheckboxConfig();

  if ($config === FALSE) {
    return;
  }

  if (($config['enable_checkbox'] === TRUE) || ($config['enable_radio'] === TRUE)) {
    $attachments['#attached']['library'][] = 'selectify/selectify-base';
    $attachments['#attached']['library'][] = 'selectify/selectify-radio-checkbox';

    $selectifyConfig = $helper->getConfig();
    $isAdmin = $helper->isAdminRoute();
    $selected_accent = $isAdmin ? $selectifyConfig->get('admin_accent_color') : $config['accent_color'];
    $accent_color_mode = $isAdmin
      ? ($selectifyConfig->get('admin_accent_color_mode') ?: 'light')
      : ($selectifyConfig->get('accent_color_mode') ?: 'light');

    if (!empty($selected_accent) && $selected_accent !== 'none' && $accent_color_mode !== 'none') {
      $attachments['#attached']['library'][] = "selectify/selectify-color-{$selected_accent}-{$accent_color_mode}";
    }
  }
}

/**
 * Implements hook_page_attachments_alter().
 */
function selectify_page_attachments_alter(array &$attachments): void {
  /** @var \Drupal\selectify\Service\SelectifyHelper $helper */
  $helper = \Drupal::service('selectify.helper');

  // Check if current page is in the disabled pages list.
  if ($helper->isPageDisabled()) {
    if (isset($attachments['#attached']['library'])) {
      foreach ($attachments['#attached']['library'] as $key => $library) {
        if (is_string($library) && strpos($library, 'selectify/') === 0) {
          unset($attachments['#attached']['library'][$key]);
        }
      }
    }
    if (isset($attachments['#attached']['drupalSettings']['selectify'])) {
      unset($attachments['#attached']['drupalSettings']['selectify']);
    }
    return;
  }

  // Load configuration.
  $selectifyConfig = $helper->getConfig();

  // Attach radio-checkbox library and inject CSS variables if enabled.
  $radioEnabled = (bool) $selectifyConfig->get('enable_radio');
  $checkboxEnabled = (bool) $selectifyConfig->get('enable_checkbox');

  if ($radioEnabled || $checkboxEnabled) {
    $attachments['#attached']['library'][] = 'selectify/selectify-radio-checkbox';

    /** @var \Drupal\selectify\Service\SelectifyStyleService $styleService */
    $styleService = \Drupal::service('selectify.style_service');
    $inlineCSS = $styleService->getConfiguredInlineCss();

    if (!empty($inlineCSS)) {
      $attachments['#attached']['html_head'][] = [
        [
          '#tag' => 'style',
          '#value' => $inlineCSS,
          '#attributes' => ['id' => 'selectify-inline-variables'],
        ],
        'selectify_inline_variables',
      ];
    }

    $isAdmin = $helper->isAdminRoute();
    $accentColor = $isAdmin
      ? $selectifyConfig->get('admin_accent_color')
      : $selectifyConfig->get('accent_color');
    $accentColorMode = $isAdmin
      ? ($selectifyConfig->get('admin_accent_color_mode') ?? 'light')
      : ($selectifyConfig->get('accent_color_mode') ?? 'light');

    if (!empty($accentColor) && $accentColor !== 'none' && $accentColorMode !== 'none') {
      $attachments['#attached']['library'][] = "selectify/selectify-color-{$accentColor}-{$accentColorMode}";
    }
  }

  // Gin theme integration.
  if ($helper->isBaseTheme('gin')) {
    $attachments['#attached']['library'][] = 'selectify/selectify-gin-base';

    $adminColorMode = $selectifyConfig->get('admin_accent_color_mode') ?? 'light';
    if ($adminColorMode === 'dark') {
      $attachments['#attached']['library'][] = 'selectify/selectify-gin-dark';
    }
    elseif ($adminColorMode === 'light') {
      $attachments['#attached']['library'][] = 'selectify/selectify-gin-light';
    }
  }

  // Claro theme integration.
  if ($helper->isBaseTheme('claro')) {
    $attachments['#attached']['library'][] = 'selectify/selectify-claro';
  }

  // Olivero theme integration.
  if ($helper->isBaseTheme('olivero')) {
    $attachments['#attached']['library'][] = 'selectify/selectify-olivero';
  }
}

/**
 * Implements hook_preprocess_container().
 */
function selectify_preprocess_container(array &$variables): void {
  if (empty($variables['attributes'])) {
    return;
  }

  $attr = $variables['attributes'];
  $classes = [];

  // Normalize classes to a clean string[] in all cases.
  if ($attr instanceof Attribute) {
    $classes = $attr->offsetGet('class') ?? [];
  }
  elseif (is_array($attr) && array_key_exists('class', $attr)) {
    $classes = $attr['class'];
  }
  elseif (isset($attr['class'])) {
    $classes = $attr['class'];
  }

  if (is_string($classes)) {
    $classes = preg_split('/\s+/', trim($classes), -1, PREG_SPLIT_NO_EMPTY) ?: [];
  }
  elseif (!is_array($classes)) {
    $classes = [];
  }

  if (!$classes) {
    return;
  }

  foreach ($classes as $class) {
    if (is_string($class) && str_starts_with($class, 'field--widget-selectify-')) {
      $max = $variables['element']['widget'][0]['#attributes']['data-max-selections'] ?? NULL;
      $new_class = ($max === '1') ? 'selectify-single' : 'selectify-multi';

      if ($attr instanceof Attribute) {
        $variables['attributes']->addClass($new_class);
      }
      else {
        if (!isset($variables['attributes']['class']) || !is_array($variables['attributes']['class'])) {
          $variables['attributes']['class'] = (array) ($variables['attributes']['class'] ?? []);
        }
        $variables['attributes']['class'][] = $new_class;
      }
      break;
    }
  }
}

/**
 * Implements hook_preprocess_views_exposed_form() for Selectify.
 */
function selectify_preprocess_views_exposed_form(&$variables) {
  $form = &$variables['form'];

  /** @var \Drupal\selectify\Service\SelectifyHelper $helper */
  $helper = \Drupal::service('selectify.helper');

  if ($helper->isPageDisabled()) {
    return;
  }

  if ($helper->isDisabledOnAdminRoute()) {
    return;
  }

  // Add the 'selectify-views' class to all select elements.
  foreach ($form as &$element) {
    if (is_array($element) && isset($element['#type']) && $element['#type'] === 'select') {
      $element['#attributes'] = $element['#attributes'] ?? [];
      $element['#attributes']['class'] = $element['#attributes']['class'] ?? [];
      $element['#attributes']['class'][] = 'selectify-views';
    }
  }
  unset($element);

  // Retrieve the Selectify configuration.
  $config = $helper->getViewsConfig();
  $apply_site_wide = $config['apply_site_wide'];
  $global_widget = $config['global_widget'];
  $widget_map = $config['widget_map'];
  $clean_form_id = $helper->normalizeFormId($form);

  // Determine widget to apply.
  $widget_to_apply = NULL;
  if ($apply_site_wide) {
    $widget_to_apply = $global_widget;
  }
  else {
    foreach ($widget_map as $widget_data) {
      $stored_id = $widget_data['exposed_form_id'] ?? '';
      $normalized_id = str_replace('_', '-', $stored_id);

      if (!empty($normalized_id) && $normalized_id === $clean_form_id) {
        $widget_to_apply = $widget_data['widget'];
        break;
      }
    }
  }

  // Allow other modules to alter the widget selection.
  if (!empty($widget_to_apply)) {
    $view = $variables['view'] ?? NULL;
    $context = [
      'form_id' => $clean_form_id,
      'form' => &$form,
      'integration_type' => 'views',
      'view_name' => ($view && is_object($view) && method_exists($view, 'id')) ? $view->id() : NULL,
      'display_id' => ($view && is_object($view) && isset($view->current_display)) ? $view->current_display : NULL,
    ];
    \Drupal::moduleHandler()->alter('selectify_widget', $widget_to_apply, $context);
  }

  // Apply global or per-view widget.
  if (!empty($widget_to_apply)) {
    $helper->applyWidgetToForm($form, $widget_to_apply);
  }

  // Add single/multi class to each select wrapper.
  foreach ($form as &$element) {
    if (is_array($element) && isset($element['#type']) && $element['#type'] === 'select') {
      $is_multiple = isset($element['#multiple']) && $element['#multiple'] === TRUE;
      $element['#wrapper_attributes']['class'][] = $is_multiple ? 'selectify-multi' : 'selectify-single';
    }
  }
}

/**
 * Implements hook_form_alter().
 *
 * Applies Selectify widgets to plain Form API <select> elements.
 * Skips Views exposed forms (handled by hook_preprocess_views_exposed_form)
 * and elements already styled by field widgets.
 */
function selectify_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  /** @var \Drupal\selectify\Service\SelectifyHelper $helper */
  $helper = \Drupal::service('selectify.helper');

  // Bail early if the feature is disabled or on a disabled admin route.
  $config = $helper->getFormApiConfig();
  if ($config === FALSE) {
    return;
  }

  // Bail if page is in the disabled pages list.
  if ($helper->isPageDisabled()) {
    return;
  }

  // Skip Views exposed forms — handled by hook_preprocess_views_exposed_form().
  if (str_starts_with($form_id, 'views_exposed_form')) {
    return;
  }

  // Skip Webform submission forms if the selectify_webform submodule handles
  // them.
  if (str_starts_with($form_id, 'webform_submission_') &&
      \Drupal::moduleHandler()->moduleExists('selectify_webform')) {
    return;
  }

  // Check built-in blocklist (always-excluded admin forms: Field UI,
  // Views UI, Layout Builder, etc.) that break with custom selects.
  if ($helper->isFormExcluded($form_id)) {
    return;
  }

  // Allow other modules to prevent Selectify from applying to this form.
  $applicable = TRUE;
  $context = [
    'form_id' => $form_id,
    'form' => &$form,
    'integration_type' => 'form_api',
  ];
  \Drupal::moduleHandler()->alter('selectify_is_applicable', $applicable, $context);
  if (!$applicable) {
    return;
  }

  // Also skip any form element that has an #ajax callback on a select,
  // since custom select replacement can break AJAX triggers.
  // (Individual selects with #ajax are skipped in the recursive walker.)
  // Record this form in the discovered list if it contains any eligible
  // (non-AJAX, non-field-widget) selects. This powers the Views-like
  // configuration UI for Form API.
  if (_selectify_form_api_has_eligible_select($form)) {
    _selectify_form_api_record_discovered_form($form_id);
  }

  // Compute accent color library once for this request.
  $selectifyConfig = $helper->getConfig();
  $isAdmin = $helper->isAdminRoute();
  $accent = $isAdmin
    ? ($selectifyConfig->get('admin_accent_color') ?: 'neutral')
    : ($selectifyConfig->get('accent_color') ?: 'neutral');
  $accent_mode = $isAdmin
    ? ($selectifyConfig->get('admin_accent_color_mode') ?: 'light')
    : ($selectifyConfig->get('accent_color_mode') ?: 'light');
  $accent_library = NULL;
  if (!empty($accent) && $accent !== 'none' && $accent_mode !== 'none') {
    $accent_library = "selectify/selectify-color-{$accent}-{$accent_mode}";
  }

  // CSS selector rules: apply per-element targeting first. Matched selects
  // receive their rule's widget and are marked with selectify-apply-* so
  // the per-form widget step (below) will not override them.
  $css_rules = $config['css_selector_rules'] ?? [];
  if (!empty($css_rules)) {
    _selectify_apply_css_selector_rules($form, $helper, $css_rules, $accent_library);
  }

  // Form API does not have a global "apply to all forms" mode. Only forms
  // explicitly configured in the per-form widget map will be styled.
  $widget = $config['widget_map'][$form_id] ?? 'none';

  // Allow other modules to alter the widget selection.
  $context = [
    'form_id' => $form_id,
    'form' => &$form,
    'integration_type' => 'form_api',
  ];
  \Drupal::moduleHandler()->alter('selectify_widget', $widget, $context);

  if (empty($widget) || $widget === 'none') {
    return;
  }

  _selectify_apply_to_form_selects($form, $helper, $widget, $accent_library);
}

/**
 * Checks whether a form contains at least one eligible Form API select.
 *
 * Eligible means:
 * - #type === 'select'
 * - no #ajax callback
 * - not a field-widget select (no #key_column)
 * - not already styled by Selectify (no selectify-apply-* class)
 *
 * @param array $elements
 *   The form render array (or sub-array).
 * @param int $depth
 *   Current recursion depth (internal use).
 *
 * @return bool
 *   TRUE if the form contains an eligible select, FALSE otherwise.
 */
function _selectify_form_api_has_eligible_select(array $elements, int $depth = 0): bool {
  // Prevent infinite recursion on malformed forms (max depth: 50 levels).
  if ($depth > 50) {
    return FALSE;
  }

  foreach (Element::children($elements) as $key) {
    if (!is_array($elements[$key])) {
      continue;
    }

    if (($elements[$key]['#type'] ?? NULL) === 'select') {
      if (!empty($elements[$key]['#ajax'])) {
        continue;
      }
      if (isset($elements[$key]['#key_column'])) {
        continue;
      }

      $existing = (array) ($elements[$key]['#attributes']['class'] ?? []);
      foreach ($existing as $cls) {
        if (is_string($cls) && str_starts_with($cls, 'selectify-apply-')) {
          continue 2;
        }
      }

      return TRUE;
    }

    if (_selectify_form_api_has_eligible_select($elements[$key], $depth + 1)) {
      return TRUE;
    }
  }

  return FALSE;
}

/**
 * Records a discovered Form API form ID in state storage.
 *
 * @param string $form_id
 *   The form ID.
 */
function _selectify_form_api_record_discovered_form(string $form_id): void {
  // Sanitize form_id to prevent state storage abuse.
  $form_id = preg_replace('/[^a-zA-Z0-9_-]/', '', $form_id);
  if (empty($form_id) || strlen($form_id) > 255) {
    return;
  }

  $state = \Drupal::state();
  $existing = $state->get('selectify.form_api_discovered_forms', []);
  if (!is_array($existing)) {
    $existing = [];
  }

  // Limit discovered forms list to prevent unbounded growth. Keep only the
  // 1000 most recently seen forms.
  if (count($existing) >= 1000 && !isset($existing[$form_id])) {
    // Remove oldest entries (by last_seen timestamp).
    uasort($existing, function ($a, $b) {
      $a_time = (is_array($a) && isset($a['last_seen'])) ? (int) $a['last_seen'] : 0;
      $b_time = (is_array($b) && isset($b['last_seen'])) ? (int) $b['last_seen'] : 0;
      return $a_time <=> $b_time;
    });
    $existing = array_slice($existing, -999, 999, TRUE);
  }

  $existing[$form_id] = [
    'last_seen' => \Drupal::time()->getRequestTime(),
  ];

  $state->set('selectify.form_api_discovered_forms', $existing);
}

/**
 * Applies CSS selector rules to matching select elements in a form.
 *
 * Walks the form tree and checks each select against the configured CSS
 * selector rules. When a match is found, the rule's widget is applied to
 * that specific select. This runs before the per-form widget so that
 * the already_styled guard prevents double-processing.
 *
 * @param array &$elements
 *   The form array (or sub-array) to process.
 * @param \Drupal\selectify\Service\SelectifyHelperInterface $helper
 *   The selectify helper service.
 * @param array $rules
 *   Array of CSS selector rules, each with 'selector' and 'widget' keys.
 * @param string|null $accent_library
 *   Optional accent colour library to attach.
 * @param int $depth
 *   Current recursion depth (internal use).
 */
function _selectify_apply_css_selector_rules(array &$elements, $helper, array $rules, ?string $accent_library, int $depth = 0): void {
  if ($depth > 50) {
    return;
  }

  foreach (Element::children($elements) as $key) {
    if (!is_array($elements[$key])) {
      continue;
    }

    if (isset($elements[$key]['#type']) && $elements[$key]['#type'] === 'select') {
      // Single eligibility check (shared with per-form walker).
      if (!$helper->isSelectEligibleForStyling($elements[$key])) {
        continue;
      }

      // Check each CSS selector rule for a match.
      foreach ($rules as $rule) {
        $selector = $rule['selector'] ?? '';
        $rule_widget = $rule['widget'] ?? '';
        if (empty($selector) || empty($rule_widget)) {
          continue;
        }

        if ($helper->elementMatchesCssSelector($elements[$key], $key, $selector)) {
          // Allow other modules to alter the element.
          $element_context = [
            'widget' => $rule_widget,
            'form_id' => $elements['#form_id'] ?? NULL,
            'element_key' => $key,
            'integration_type' => 'form_api',
            'css_selector' => $selector,
          ];
          \Drupal::moduleHandler()->alter('selectify_element', $elements[$key], $element_context);

          if (!empty($elements[$key]['#selectify_skip'])) {
            break;
          }

          // Single styling source (shared with per-form walker).
          $helper->applyWidgetStyling($elements[$key], $rule_widget, $accent_library);

          // First matching rule wins — stop checking further rules.
          break;
        }
      }
    }

    // Recurse into children.
    _selectify_apply_css_selector_rules(
      $elements[$key],
      $helper,
      $rules,
      $accent_library,
      $depth + 1
    );
  }
}

/**
 * Applies Selectify widget to form select elements recursively.
 *
 * Walks the form tree depth-first. Skips any select that already carries a
 * selectify-apply-* class (i.e. it was styled by a field widget or Views).
 *
 * @param array &$elements
 *   The form array (or sub-array) to process.
 * @param \Drupal\selectify\Service\SelectifyHelperInterface $helper
 *   The selectify helper service.
 * @param string $widget
 *   The widget machine name (e.g. 'selectify_dropdown').
 * @param string|null $accent_library
 *   Optional accent colour library to attach.
 * @param int $depth
 *   Current recursion depth (internal use).
 */
function _selectify_apply_to_form_selects(
  array &$elements,
  $helper,
  string $widget,
  ?string $accent_library,
  int $depth = 0,
): void {
  if ($depth > 50) {
    return;
  }

  foreach (Element::children($elements) as $key) {
    if (!is_array($elements[$key])) {
      continue;
    }

    // If this element is a select, apply the widget.
    if (isset($elements[$key]['#type']) && $elements[$key]['#type'] === 'select') {
      // Single eligibility check (shared with CSS selector walker).
      if (!$helper->isSelectEligibleForStyling($elements[$key])) {
        continue;
      }

      // Allow other modules to alter the element before Selectify processes it.
      $element_context = [
        'widget' => $widget,
        'form_id' => $elements['#form_id'] ?? NULL,
        'element_key' => $key,
        'integration_type' => 'form_api',
      ];
      \Drupal::moduleHandler()->alter('selectify_element', $elements[$key], $element_context);

      // Check if the element was marked to skip Selectify processing.
      if (!empty($elements[$key]['#selectify_skip'])) {
        continue;
      }

      // Single styling source (shared with CSS selector walker).
      $helper->applyWidgetStyling($elements[$key], $widget, $accent_library);
    }

    // Recurse into children (containers, fieldsets, details, etc.).
    _selectify_apply_to_form_selects(
      $elements[$key],
      $helper,
      $widget,
      $accent_library,
      $depth + 1
    );
  }
}
