<?php

/**
 * @file
 * Install, update, and uninstall functions for the Selectify module.
 */

/**
 * Implements hook_uninstall().
 *
 * Removes all config and state so that reinstalling the module starts with
 * default values. Any new config or state keys added in future must be
 * cleared here.
 */
function selectify_uninstall(): void {
  $config_factory = \Drupal::configFactory();
  $state = \Drupal::state();

  // Remove all module configuration (user settings).
  $config_factory->getEditable('selectify.settings')->delete();

  // Remove all module state (e.g. discovered forms list).
  $state->delete('selectify.form_api_discovered_forms');
}

/**
 * Add Form API select element configuration settings.
 */
function selectify_update_10001(): void {
  $config = \Drupal::configFactory()->getEditable('selectify.settings');
  $changed = FALSE;
  if ($config->get('enable_form_api_selects') === NULL) {
    $config->set('enable_form_api_selects', FALSE);
    $config->set('form_api_widget', 'selectify_dropdown');
    $changed = TRUE;
  }
  if ($config->get('form_api_widget_map') === NULL) {
    $config->set('form_api_widget_map', []);
    $changed = TRUE;
  }
  if ($config->get('widget_for_filters') === NULL) {
    $config->set('widget_for_filters', []);
    $changed = TRUE;
  }
  if ($changed) {
    $config->save();
  }
}

/**
 * Remove deprecated form_api_excluded_forms config (additional excluded form
 * IDs).
 */
function selectify_update_10002(): void {
  $config = \Drupal::configFactory()->getEditable('selectify.settings');
  if ($config->get('form_api_excluded_forms') !== NULL) {
    $config->clear('form_api_excluded_forms');
    $config->save();
  }
}

/**
 * Add CSS selector widget map configuration for Form API selects.
 */
function selectify_update_10003(): void {
  $config = \Drupal::configFactory()->getEditable('selectify.settings');
  if ($config->get('css_selector_widget_map') === NULL) {
    $config->set('css_selector_widget_map', []);
    $config->save();
  }
}

/**
 * Remove deprecated form_api_widget default config key.
 *
 * Widget selection is now done exclusively per-form or per-CSS-selector.
 */
function selectify_update_10004(): void {
  $config = \Drupal::configFactory()->getEditable('selectify.settings');
  if ($config->get('form_api_widget') !== NULL) {
    $config->clear('form_api_widget');
    $config->save();
  }
}
