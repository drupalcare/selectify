<?php

/**
 * @file
 * Hook implementations for the Selectify test fixture module.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\selectify_test\Hook\SelectifyTestHooks;

/**
 * @file
 * Test module implementing Selectify alter hooks for Kernel tests.
 */

/**
 * Implements hook_selectify_widget_alter().
 */
#[LegacyHook]
function selectify_test_selectify_widget_alter(string &$widget, array $context): void {
  \Drupal::classResolver(SelectifyTestHooks::class)->selectifyWidgetAlter($widget, $context);
}

/**
 * Implements hook_selectify_element_alter().
 */
#[LegacyHook]
function selectify_test_selectify_element_alter(array &$element, array $context): void {
  \Drupal::classResolver(SelectifyTestHooks::class)->selectifyElementAlter($element, $context);
}

/**
 * Implements hook_selectify_is_applicable_alter().
 */
#[LegacyHook]
function selectify_test_selectify_is_applicable_alter(bool &$applicable, array $context): void {
  \Drupal::classResolver(SelectifyTestHooks::class)->selectifyIsApplicableAlter($applicable, $context);
}
