{#
/**
 * @file
 * Theme override for draggable radio buttons and checkboxes in Selectify.
 *
 * Available variables:
 * - field_name: The machine name of the field.
 * - selected_values: An array of selected values.
 * - options: An array of options, each with:
 *   - value: The option value.
 *   - label: The option label.
 *   - selected: Boolean indicating if it's selected.
 *   - type: 'radio' or 'checkbox'
 *
 * @see template_preprocess_selectify_draggable()
 */
#}

<div class="selectify selectify-radio-checkbox" data-field-name="{{ field_name }}">
  {% if element['#title'] is not empty %}
    <label for="{{ attributes.id }}" {{ element['#title_attributes'].addClass('form-item__label') }}>
      {{ element['#title'] }}
      {% if element['#required'] is defined and element['#required'] %}
        <span class="required-marker">*</span>
      {% endif %}
    </label>
  {% endif %}

  {# Determine input type: radio if max selection is 1, otherwise checkbox #}
  {% set input_type = attributes['data-max-selections'] == '1' ? 'radio' : 'checkbox' %}

  <ul class="selectify-list" role="{% if input_type == 'radio' %}radiogroup{% else %}group{% endif %}" aria-labelledby="{{ field_name }}-label">
    {% for option in options %}
      <li class="selectify-item">
        <input
          type="{{ input_type }}"
          name="{{ field_name }}"
          id="{{ field_name }}-{{ option.value }}"
          value="{{ option.value }}"
          {% if option.selected %} checked{% endif %}
          class="selectify-input selectify-{{ input_type }}"
        >
        <label for="{{ field_name }}-{{ option.value }}">{{ option.label }}</label>
      </li>
    {% endfor %}
  </ul>
</div>
    {% for option in options %}
      <option value="{{ option.value }}" {{ option.selected ? 'selected="selected"' }}>{{ option.label }}</option>
    {% endfor %}
